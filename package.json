{
  "name": "shani-time-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Calendar-aware WhatsApp assistant that balances school and work: weekly optimization, daily briefs, and move-on reminders.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^178.0.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "twilio": "^6.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
