# ---------- Claude ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# ---------- The person the assistant serves ----------
USER_NAME=Shani
# Her WhatsApp number in E.164 format. Only this number is allowed to talk to the agent.
USER_WHATSAPP_NUMBER=+9725XXXXXXX
# Language for scheduled messages (daily brief, weekly plan). Replies always mirror her language.
ASSISTANT_LANGUAGE=en
TIMEZONE=America/New_York

# ---------- Google Calendar (OAuth "Web application" client) ----------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Comma-separated Google calendar IDs used to classify events. Leave empty to rely on keywords only.
# Find IDs at: Google Calendar > Settings > (calendar) > Integrate calendar > Calendar ID
SCHOOL_CALENDAR_IDS=
WORK_CALENDAR_IDS=
# Calendar new events are written to (default: primary)
DEFAULT_CALENDAR_ID=primary

# ---------- WhatsApp (Twilio) ----------
# WHATSAPP_PROVIDER=console prints messages to the terminal instead of sending (for local testing)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox number is whatsapp:+14155238886 ; production uses your approved sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: an approved Content Template SID used to re-open the 24h WhatsApp window
# when a scheduled message cannot be delivered as free-form text (Twilio error 63016).
TWILIO_TEMPLATE_CONTENT_SID=

# ---------- Server ----------
PORT=3000
# Public HTTPS URL of this server. Used for OAuth redirect + Twilio signature validation.
PUBLIC_URL=https://your-host.example.com
# Hostname only (used by Caddy in docker-compose for automatic HTTPS). deploy/setup-vm.sh fills this in.
PUBLIC_HOST=your-host.example.com
# Set to "false" ONLY for local testing without Twilio signatures
VALIDATE_TWILIO_SIGNATURE=true

# ---------- Schedules (cron, evaluated in TIMEZONE) ----------
# Weekly plan runs Sunday 19:00 so the week ahead is planned the evening before it starts.
DAILY_BRIEF_CRON=30 7 * * *
WEEKLY_PLAN_CRON=0 19 * * 0
REMINDER_LEAD_MINUTES=10
QUIET_HOURS_START=23:00
QUIET_HOURS_END=07:00

DATABASE_PATH=./data/agent.sqlite
LOG_LEVEL=info
